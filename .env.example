# Copy to `.env` for local runs: cp .env.example .env
# `.env` is git-ignored. Never commit real secrets; production values live in
# the VM's .env and in GitHub Secrets.

# PostgreSQL (container `postgres`, host port 5433)
POSTGRES_DB=stockscribe
POSTGRES_USER=stockscribe
POSTGRES_PASSWORD=stockscribe

# MongoDB (container `mongo`, host port 27017)
MONGO_DATABASE=stockscribe

# Host port for the web container → http://localhost:8080
# If another app already owns 8080 (e.g. "Access Error: 404 -- Not Found"), pick another, e.g. 8081.
WEB_PORT=8080
