# Production settings · copy to /opt/stockscribe/.env ON THE VM, fill in, then: chmod 600 .env
# Never commit the filled-in file. Use single quotes so ; $ and spaces stay literal.

# Public host name (DuckDNS) and the email Let's Encrypt sends expiry warnings to.
DOMAIN=yourname.duckdns.org
LETSENCRYPT_EMAIL=you@example.com

# Neon (Sydney) · .NET format, not postgresql://  · keep GSS Encryption Mode=Disable at the end
POSTGRES_CONNECTION='Host=ep-xxxx.ap-southeast-2.aws.neon.tech;Database=stockscribe;Username=xxxx;Password=xxxx;SSL Mode=Require;GSS Encryption Mode=Disable'

# MongoDB Atlas (Sydney) · user stockscribe-api
MONGO_CONNECTION='mongodb+srv://stockscribe-api:xxxx@xxxx.mongodb.net/?retryWrites=true&w=majority&appName=stockscribe'
MONGO_DATABASE=stockscribe

# Signs the session JWT (sf_session cookie). Generate once on the VM: openssl rand -base64 48
# Changing it logs everyone out.
JWT_SIGNING_KEY='paste-the-openssl-output-here'
